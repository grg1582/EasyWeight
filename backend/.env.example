# Copy to .env to run the API outside Docker
DATABASE_URL=postgresql+psycopg://easyweight:easyweight@localhost:5432/easyweight

# Signs login tokens. Anyone who knows it can sign in as anyone: use a long
# random value anywhere other than your own computer, for example from
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-secret-change-me-in-production
